# ──────────────────────────────────────────────────────
# ParkEase — Server Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────

# Server port (default: 5000)
PORT=5000

# MongoDB connection string
# Local dev:      mongodb://127.0.0.1:27017/parkease
# Docker Compose: mongodb://mongo:27017/parkease
MONGO_URI=mongodb://127.0.0.1:27017/parkease

# JWT signing secret — use a long random string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret

# Allowed frontend origin for CORS
CLIENT_URL=http://localhost:5173

# ── Email (optional) ──────────────────────────────────
# Leave SMTP_HOST empty to print emails to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Razorpay Payment Gateway (optional — test mode) ───
# Leave empty to fall back to the simulated instant-pay mode.
# Get test keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret — configure in Razorpay dashboard → Webhooks
RAZORPAY_WEBHOOK_SECRET=

# Node environment (development | production | test)
NODE_ENV=development
