# ──────────────────────────────────────────────────────
# ParkEase — Docker Compose Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────
# JWT signing secret (must be set — Compose will error if missing)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret

# ── Ports (optional — defaults shown) ─────────────────
SERVER_PORT=5000
CLIENT_PORT=80

# ── CORS origin for the backend ───────────────────────
# Set to the public URL where the frontend is served
CLIENT_URL=http://localhost:80

# ── Razorpay Payment Gateway (optional) ───────────────
# Leave empty to use simulated instant-pay fallback
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email / SMTP (optional) ───────────────────────────
# Leave empty to log emails to the console instead
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
