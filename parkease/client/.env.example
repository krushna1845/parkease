# ──────────────────────────────────────────────────────
# ParkEase — Frontend Environment Configuration
# Copy this file to .env for local Vite development.
# ──────────────────────────────────────────────────────

# Backend API base URL for local development
# In Docker production, Nginx reverse-proxies /api to the backend container.
VITE_API_URL=http://localhost:5000/api
